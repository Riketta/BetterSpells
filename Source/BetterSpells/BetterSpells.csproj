<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BetterSpells</AssemblyName>
    <RootNamespace>BetterSpells</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\Assemblies</OutputPath>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- RimWorld loads plain mod assemblies; no deps.json needed next to the dll. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Override with -p:RimWorldDir="C:\path\to\RimWorld" if your install lives elsewhere. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <!-- 1.7+ ships game assemblies in the install root: no RimWorldWin64_Data\Managed
         and a single UnityStubs.dll instead of split UnityEngine modules. Auto-detect. -->
    <IsModernLayout Condition="'$(IsModernLayout)' == '' And !Exists('$(RimWorldDir)\RimWorldWin64_Data\Managed')">true</IsModernLayout>
    <GameManaged Condition="'$(GameManaged)' == '' And '$(IsModernLayout)' == 'true'">$(RimWorldDir)</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</GameManaged>
    <UnityLib Condition="'$(UnityLib)' == '' And '$(IsModernLayout)' == 'true'">$(GameManaged)\UnityStubs.dll</UnityLib>
    <UnityLib Condition="'$(UnityLib)' == ''">$(GameManaged)\UnityEngine.CoreModule.dll</UnityLib>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(UnityLib)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="'$(IsModernLayout)' != 'true'">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="'$(IsModernLayout)' != 'true'">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Players load the Workshop Harmony mod (declared in About.xml); Lib.Harmony is
         compile-time only - ExcludeAssets=runtime keeps the dll out of Assemblies. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
